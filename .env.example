NODE_ENV=development
PORT=5100
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/savannah-bbq
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

ADMIN_NAME=Savannah Admin
ADMIN_EMAIL=admin@savannahbbq.local
ADMIN_PASSWORD=ChangeMe123!

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Facebook Page credentials for read-only comment import and optional feed publishing.
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_GRAPH_VERSION=v20.0
FACEBOOK_PUBLISH_ENABLED=false

# Optional backwards-compatible aliases. FACEBOOK_* values are preferred when both are set.
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_PAGE_ID=your_meta_page_id_here
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_GRAPH_VERSION=v20.0

INSTAGRAM_BUSINESS_ID=your_instagram_business_id_here
TIKTOK_BUSINESS_ID=your_tiktok_business_id_here

AUTO_PUBLISH_MODE=false
LIVE_FACEBOOK_MODE=false
LIVE_SOCIAL_PUBLISHING=false

MAX_IMAGE_SIDE=1280
IMAGE_JPEG_QUALITY=80
MAX_VIDEO_SECONDS=30
MAX_VIDEO_UPLOAD_MB=50
VIDEO_FRAME_COUNT=4
